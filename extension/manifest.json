{
  "manifest_version": 3,
  "name": "LockedIn Blocker",
  "short_name": "LockedIn",
  "version": "1.0.0",
  "description": "Blocks the sites on your LockedIn block list while you focus. LockedIn decides when; this extension only follows.",
  "minimum_chrome_version": "121",
  "key": "",
  "permissions": ["declarativeNetRequest", "alarms", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"], "use_dynamic_url": true }]
}
