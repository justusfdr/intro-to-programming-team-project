# Copy this file to .env.local and fill in the real values (docs/setup.md). Never commit .env.local.
# All variables are server-only. Nothing here may start with NEXT_PUBLIC_.

# The app's public address, without a trailing slash (http://localhost:3000 locally). Used for the same-origin check.
APP_URL=http://localhost:3000

# Supabase project address (Project Settings > API > Project URL).
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (Project Settings > API Keys). Public by design, but we keep it on the server.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Database connection string: transaction pooler, port 6543 (Connect > Transaction pooler). Secret.
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-region.pooler.supabase.com:6543/postgres

# Optional. The Chrome extension's id; it follows from the public key in extension/manifest.json,
# so leave it out unless that key is replaced. Not a secret.
# EXTENSION_ID=dghmihlicabdooieaknglfjlidpjjfki
