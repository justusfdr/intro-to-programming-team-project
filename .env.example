# Copy this file to .env.local and fill in the real values (docs/setup.md). Never commit .env.local.
# All variables are server-only. Nothing here may start with NEXT_PUBLIC_.

# The app's public address, without a trailing slash (http://localhost:3000 locally). Used for the same-origin check.
APP_URL=http://localhost:3000

# Supabase project address (Project Settings > API > Project URL).
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (Project Settings > API Keys). Public by design, but we keep it on the server.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Database connection string: transaction pooler, port 6543 (Connect > Transaction pooler). Secret.
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-region.pooler.supabase.com:6543/postgres

# Optional, recommended. The certificate authority that signed the database server's certificate, in PEM form
# (Database settings > SSL configuration > Download certificate; docs/setup.md, section 6). With it the server's
# certificate and host name are checked; without it the connection is still encrypted, but not checked, and the
# server says so once in its log. One line with \n for the line breaks is fine. Not a secret.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----

# Optional. The Chrome extension's id; it follows from the public key in extension/manifest.json,
# so leave it out unless that key is replaced. Not a secret.
# EXTENSION_ID=dghmihlicabdooieaknglfjlidpjjfki

# Outlook (docs/setup.md, section 9). Without these three, Outlook stays off and the calendar works as before.
# The app registration's Application (client) ID at Microsoft. Not a secret.
MICROSOFT_CLIENT_ID=your-application-client-id
# The app registration's client secret (its Value, not its ID). Secret. It expires: renew it before then.
MICROSOFT_CLIENT_SECRET=placeholder
# Optional. "common" (the default) allows personal and work or school Microsoft accounts.
# MICROSOFT_TENANT=common
# The key that encrypts the stored Outlook access: run `openssl rand -base64 32`. Secret. Changing it
# means every user must connect Outlook again.
OUTLOOK_TOKEN_KEY=placeholder-run-openssl-rand-base64-32

# The coach (docs/setup.md, section 10). Without the key the coach says it is not available; everything else works.
# The Claude API key from platform.claude.com (API Keys). Secret. Set a monthly spending limit in the Console.
ANTHROPIC_API_KEY=placeholder
# Optional. The model; unset means claude-opus-5-5. claude-haiku-5-5 is cheaper.
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional. "true" allows the coach only for Pro users (ontology R21); unset: every signed-in user.
# CHAT_PRO_ONLY=true
